# Razorpay secrets for the payment edge functions.
#
# Local dev: copy this file to `supabase/functions/.env.local` (git-ignored) and
#   run `supabase functions serve --env-file supabase/functions/.env.local`.
# Deployed: set them with
#   supabase secrets set RAZORPAY_KEY_ID=... RAZORPAY_KEY_SECRET=... \
#     RAZORPAY_WEBHOOK_SECRET=... --project-ref gjaetfqanqnpwajxryrt
#
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY are injected by
# the Edge runtime automatically — do NOT set them here.

# Razorpay Dashboard -> Settings -> API Keys. Use rzp_test_* until KYC is live.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay Dashboard -> Settings -> Webhooks. The secret you set when creating
# the webhook that points at .../functions/v1/razorpay-webhook.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
